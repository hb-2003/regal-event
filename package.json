{
  "name": "regal-events",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run migration:run && npm run build",
    "start": "next start",
    "lint": "eslint",
    "migration:generate": "TS_NODE_PROJECT=tsconfig.migration.json node ./node_modules/typeorm/cli-ts-node-commonjs.js migration:generate -d ./src/server/database/migration-datasource.ts",
    "migration:run": "TS_NODE_PROJECT=tsconfig.migration.json node ./node_modules/typeorm/cli-ts-node-commonjs.js migration:run -d ./src/server/database/migration-datasource.ts",
    "migration:revert": "TS_NODE_PROJECT=tsconfig.migration.json node ./node_modules/typeorm/cli-ts-node-commonjs.js migration:revert -d ./src/server/database/migration-datasource.ts",
    "db:check": "ts-node --project tsconfig.migration.json scripts/db-check.ts",
    "db:seed": "ts-node -r tsconfig-paths/register --project tsconfig.migration.json src/server/database/seed.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.184.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.23",
    "next": "16.2.4",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "split-type": "^0.3.4",
    "three": "^0.184.0",
    "typeorm": "^0.3.29"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
