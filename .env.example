# Required: long random string. Generate with `openssl rand -base64 48`
JWT_SECRET=

# PostgreSQL — local install (e.g. Homebrew):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/regal_events
# Docker Compose app service uses: postgres://regaladmin:regalpassword@localhost:5432/regal_events

# Schema: npm run db:check  &&  npm run migration:generate -- ./migrations/InitialSchema  &&  npm run migration:run
# Seed:   npm run db:seed  (after migrations on a fresh database)
# Docker: docker compose up  (migrate service runs migration:run automatically before app)
# Vercel: set DATABASE_URL, JWT_SECRET, ADMIN_* in project env (enable for Build); vercel-build runs db:setup
# Vercel Blob: create a Blob store in the Vercel project (Storage → Blob). BLOB_READ_WRITE_TOKEN is set automatically.
BLOB_READ_WRITE_TOKEN=

# Initial admin credentials (only used when seeding the DB for the first time)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SMTP for transactional email (EMAIL_* or SMTP_* / MAIL_FROM are equivalent)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Regal Event London <noreply@regalevent.co.uk>"
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=  MAIL_FROM=
ADMIN_EMAIL=admin@regalevent.co.uk

# Public site URL (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
